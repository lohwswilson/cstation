# PostgreSQL Configuration Template
# Generated by CStation Server Setup

# Connection Settings
listen_addresses = '*'
port = 5432
max_connections = {{ max_connections | default(100) }}

# Memory Settings
shared_buffers = {{ shared_buffers | default('256MB') }}
effective_cache_size = {{ effective_cache_size | default('1GB') }}
work_mem = {{ work_mem | default('4MB') }}
maintenance_work_mem = {{ maintenance_work_mem | default('64MB') }}

# WAL Settings
wal_level = replica
max_wal_size = {{ max_wal_size | default('1GB') }}
min_wal_size = {{ min_wal_size | default('80MB') }}
checkpoint_completion_target = 0.9

# Logging Settings
logging_collector = on
log_directory = 'log'
log_filename = 'postgresql-%Y-%m-%d_%H%M%S.log'
log_rotation_age = 1d
log_rotation_size = 10MB
log_min_duration_statement = {{ log_min_duration | default(1000) }}
log_line_prefix = '%t [%p]: [%l-1] user=%u,db=%d,app=%a,client=%h '
log_checkpoints = on
log_connections = on
log_disconnections = on
log_lock_waits = on

# Performance Settings
random_page_cost = {{ random_page_cost | default(1.1) }}
effective_io_concurrency = {{ effective_io_concurrency | default(200) }}
max_worker_processes = {{ max_worker_processes | default(8) }}
max_parallel_workers_per_gather = {{ max_parallel_workers_per_gather | default(2) }}
max_parallel_workers = {{ max_parallel_workers | default(8) }}
max_parallel_maintenance_workers = {{ max_parallel_maintenance_workers | default(2) }}

# Autovacuum Settings
autovacuum = on
autovacuum_max_workers = {{ autovacuum_max_workers | default(3) }}
autovacuum_naptime = {{ autovacuum_naptime | default('1min') }}
autovacuum_vacuum_threshold = {{ autovacuum_vacuum_threshold | default(50) }}
autovacuum_analyze_threshold = {{ autovacuum_analyze_threshold | default(50) }}

# Security Settings
ssl = {{ ssl_enabled | default('off') }}
{% if ssl_enabled == 'on' %}
ssl_cert_file = '{{ ssl_cert_file | default('/etc/ssl/certs/ssl-cert-snakeoil.pem') }}'
ssl_key_file = '{{ ssl_key_file | default('/etc/ssl/private/ssl-cert-snakeoil.key') }}'
{% endif %}

# Locale Settings
lc_messages = '{{ locale | default('en_US.UTF-8') }}'
lc_monetary = '{{ locale | default('en_US.UTF-8') }}'
lc_numeric = '{{ locale | default('en_US.UTF-8') }}'
lc_time = '{{ locale | default('en_US.UTF-8') }}'

# Default Text Search Configuration
default_text_search_config = 'pg_catalog.english'

# Timezone
timezone = '{{ timezone | default('UTC') }}'