if [ -z "$1" ];
then
    echo "Please provide hostname and version for syncing PW_ADDONS files to DB Server"
    echo "This is only for Digital Ocean Cluster Setup"
    echo
    echo "./cs_rsync_pw_and_addons [host] [version] [port]"
    echo "./cs_rsync_pw_and_addons sg07-db 3 8288"
    echo ""
    echo "[host] -> host, group of hosts ( from inventory definition )"
    echo "[version] -> 2.0 - PW2.0 , 3.0 - PW3.0 , 3.5 - PW3.5"
    echo "[port] -> 22 or 8288"
    echo ""
else
    echo "Start Building Files to Sync to Docker"
    rm -rf ./PW.$2
    rsync -avzhe --delete --exclude  '.*' /opt/PW/PW.$2/  ./PW.$2
    mv ./PW.$2/odoo/addons/* ./PW.$2/addons/
    rm -rf ./PW.$2/odoo/addons
    mv ./PW.$2/addons ./PW.$2/odoo/
    find ./ -name __pycache__ -type d -exec rm -rf {} + 
    echo "Syncing files to Server: $1.synercatalyst.com"
    rsync -avzhe "ssh -p$3"  --delete --exclude  '.*'  ./PW.$2/odoo/ root@$1.synercatalyst.com:/var/lib/perfectwork/PW.$2
    rm -rf ./PW.$2
fi
