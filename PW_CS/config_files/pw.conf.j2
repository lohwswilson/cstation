[options]
addons_path = {{ pw_addons_path }}
app_store = install
csv_internal_sep = ,
data_dir = /var/lib/odoo
db_host = {{ PW_db_host }}
admin_passwd = {{ pw_admin_password }}
db_maxconn = {{ pw_db_maxconn }}
db_name = False
# db_name = {{ ansible_hostname }}_{{PW_container_name }}_{{ PW_db_host }}
# db_password = {{ pw_db_password }}
# db_port = {{ pw_db_port }}
db_sslmode = prefer
db_template = template1
# db_user = {{ pw_db_user }}
dbfilter = {{ pw_dbfilter}}
email_from = False
geoip_database = /usr/share/GeoIP/GeoLiteCity.dat
http_enable = True
http_interface =
http_port = 8069
longpolling_port = 8072
import_partial =
list_db = True
log_db = False
log_db_level = warning
log_handler = :INFO
log_level = info
logfile = False
logrotate = True
max_cron_threads = 2
osv_memory_age_limit = 1.0
osv_memory_count_limit = False
pg_path = /usr/bin
pidfile = False
proxy_mode = True
reportgz = False
server_wide_modules = {{ pw_server_wide_modules }}
unaccent = False
without_demo = False
workers = {{ pw_workers }}
limit_request = {{ pw_limit_request }}
limit_time_cpu = {{ pw_limit_time_cpu }}
limit_time_real = {{ pw_limit_time_real }}
# limit_time_real_cron = -1