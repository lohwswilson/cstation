if [ -z "$1" ];
then
    echo
    echo "./cs_rsync_pw_cs [host] [port]"
    echo "./cs_rsync_pw_cs us01 8288"
    echo ""
    echo "[host] -> host, group of hosts ( from inventory definition )"
    echo "[port] -> SSH port for the server"
    echo ""
else
    echo "Syncing files to Server: $1.synercatalyst.com"
    rsync -avzhe "ssh -p$2"  --delete --exclude  '.*' root@$1.synercatalyst.com:/opt/PW/PW_CS /opt/PW/PW_CS
    echo " Complete Syncing..."
fi
