---
# Ansible Vault Template for Sensitive Variables
# Copy this file to secrets.yml and encrypt it with: ansible-vault encrypt secrets.yml
# Edit encrypted vault with: ansible-vault edit secrets.yml

# =============================================================================
# DATABASE PASSWORDS
# =============================================================================

# PostgreSQL database password (used across all environments)
vault_postgresql_password: "CHANGE_ME_POSTGRESQL_PASSWORD"

# =============================================================================
# SYSTEM PASSWORDS
# =============================================================================

# Local sudo password for development environment
vault_local_sudo_password: "CHANGE_ME_LOCAL_SUDO_PASSWORD"

# Portainer admin password for container management
vault_portainer_admin_password: "CHANGE_ME_PORTAINER_ADMIN_PASSWORD"

# =============================================================================
# API TOKENS AND KEYS
# =============================================================================

# Traefik Pilot tokens for different servers
vault_traefik_pilot_token_sg01: "CHANGE_ME_TRAEFIK_PILOT_TOKEN_SG01"
vault_traefik_pilot_token_sg02: "CHANGE_ME_TRAEFIK_PILOT_TOKEN_SG02"

# =============================================================================
# SSL CERTIFICATES AND KEYS
# =============================================================================

# Add SSL certificate variables here if needed
# vault_ssl_cert: |
#   -----BEGIN CERTIFICATE-----
#   CHANGE_ME_SSL_CERTIFICATE_CONTENT
#   -----END CERTIFICATE-----

# vault_ssl_key: |
#   -----BEGIN PRIVATE KEY-----
#   CHANGE_ME_SSL_PRIVATE_KEY_CONTENT
#   -----END PRIVATE KEY-----

# =============================================================================
# THIRD-PARTY SERVICE CREDENTIALS
# =============================================================================

# Add any third-party service credentials here
# vault_aws_access_key: "CHANGE_ME_AWS_ACCESS_KEY"
# vault_aws_secret_key: "CHANGE_ME_AWS_SECRET_KEY"
# vault_github_token: "CHANGE_ME_GITHUB_TOKEN"