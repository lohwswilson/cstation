# Default Nginx Site Configuration
# Generated by CStation Server Setup

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    
    server_name {{ server_name | default('_') }};
    root {{ document_root | default('/var/www/html') }};
    index {{ index_files | default('index.html index.htm index.nginx-debian.html') }};
    
    # Security headers
    add_header X-Frame-Options DENY;
    add_header X-Content-Type-Options nosniff;
    add_header X-XSS-Protection "1; mode=block";
    
    # Main location
    location / {
        try_files $uri $uri/ =404;
    }
    
    # Security: Deny access to hidden files
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
    
    # Security: Deny access to backup files
    location ~ ~$ {
        deny all;
        access_log off;
        log_not_found off;
    }
    
    # Optimize static file serving
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|pdf|txt)$ {
        expires {{ static_file_expires | default('1y') }};
        add_header Cache-Control "public, immutable";
        access_log off;
    }
    
    # PHP processing (if enabled)
    {% if php_enabled | default(false) %}
    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass {{ php_fpm_socket | default('unix:/var/run/php/php8.1-fpm.sock') }};
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
    }
    {% endif %}
    
    # Rate limiting for sensitive areas
    {% if rate_limiting_enabled | default(true) %}
    location /login {
        limit_req zone=login burst=5 nodelay;
        try_files $uri $uri/ =404;
    }
    
    location /admin {
        limit_req zone=login burst=3 nodelay;
        try_files $uri $uri/ =404;
    }
    {% endif %}
    
    # Health check endpoint
    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }
    
    # Error pages
    error_page 404 /404.html;
    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /var/www/html;
    }
}

{% if ssl_enabled | default(false) %}
# HTTPS server configuration
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    
    server_name {{ server_name | default('_') }};
    root {{ document_root | default('/var/www/html') }};
    index {{ index_files | default('index.html index.htm index.nginx-debian.html') }};
    
    # SSL configuration
    ssl_certificate {{ ssl_certificate | default('/etc/ssl/certs/ssl-cert-snakeoil.pem') }};
    ssl_certificate_key {{ ssl_certificate_key | default('/etc/ssl/private/ssl-cert-snakeoil.key') }};
    
    # SSL security settings
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    
    # HSTS (optional)
    {% if hsts_enabled | default(false) %}
    add_header Strict-Transport-Security "max-age={{ hsts_max_age | default('31536000') }}; includeSubDomains" always;
    {% endif %}
    
    # Same location blocks as HTTP server
    location / {
        try_files $uri $uri/ =404;
    }
    
    # Include all other location blocks from HTTP configuration
    # (duplicated for clarity - in production, consider using includes)
}

# Redirect HTTP to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name {{ server_name | default('_') }};
    return 301 https://$server_name$request_uri;
}
{% endif %}